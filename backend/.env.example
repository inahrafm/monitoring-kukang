# Salin ke backend/.env lalu isi nilainya
PORT=5000
NODE_ENV=production

DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# String acak panjang, mis. hasil: openssl rand -hex 32
JWT_SECRET=

MQTT_BROKER=mqtt://103.197.189.18:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Harus unik per instance backend (jangan jalankan 2 instance dengan ID sama)
MQTT_CLIENT_ID=kukang_backend

ALERT_CHECK_INTERVAL=60000
# Alert yang sama (kandang + sensor + jenis) tidak dicatat ulang dalam rentang ini
ALERT_COOLDOWN_MINUTES=30

# Origin frontend yang boleh akses API, dipisah koma
CORS_ORIGINS=http://localhost:3000,http://<IP_SERVER>:<PORT_FRONTEND>
